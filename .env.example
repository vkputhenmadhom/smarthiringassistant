# Environment Variables for Smart Hiring Assistant
# Copy this file to .env and update with your actual values

# JWT Configuration
# Shared by auth-service and api-gateway; at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/smart_hiring_db
DB_USERNAME=hiring_user
DB_PASSWORD=hiring_password

# Encrypts sensitive resume data (file content, name, email, phone, location, summary) in resume-parser.
# At least 32 characters, e.g. `openssl rand -base64 48`. Keep it: data encrypted with a lost key is unreadable.
RESUME_ENCRYPTION_KEY=replace-with-a-long-random-secret
# When changing the key, put the old one here for one restart: resume-parser re-encrypts existing data with the
# new key at startup and logs when nothing is left under the old key; then remove it. Earlier releases used the
# public default `change-me-with-32-plus-char-secret`; set it here once if your database has resumes from them.
RESUME_ENCRYPTION_PREVIOUS_KEYS=

# Docker Compose infrastructure credentials (required by docker-compose*.yml).
# They are applied when a volume is first created; changing them later needs `docker compose down -v`.
POSTGRES_USER=hiring_user
POSTGRES_PASSWORD=change-me-postgres
MONGO_USERNAME=hiring_user
MONGO_PASSWORD=change-me-mongo
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hiring_user
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# LLM provider for ai-integration-service: openai (default) or anthropic.
# The model is chosen server-side; override with OPENAI_MODEL / ANTHROPIC_MODEL.
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
# OpenAI API (needed when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Job import (job-analyzer-service): India tech, India government and remote-open-to-India feeds.
# JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free plan: 200 requests a month)
JSEARCH_API_KEY=
# Adzuna: register free at https://developer.adzuna.com; the dashboard shows the Application ID and Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Logging Level
LOGGING_LEVEL=INFO

# OAuth Configuration (Auth Service)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth callbacks must go directly to auth-service (not gateway) so the JSESSIONID
# that holds the state/portal hint is present on the callback request.
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/login/oauth2/code/google
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login
OAUTH2_SUCCESS_REDIRECT_URI_CANDIDATE=http://localhost:5173/auth/callback
OAUTH2_SUCCESS_REDIRECT_URI_HR_ADMIN=http://localhost:4200/auth/callback

# Google-verified emails that become approved HR admins on first Google sign-in.
# Other HR sign-ups stay pending until one of these admins approves them.
BOOTSTRAP_ADMIN_EMAILS=

# Candidate portal: override OAuth base if needed (defaults to localhost:8001 direct)
# VITE_OAUTH_BASE_URL=http://localhost:8001/api/auth/oauth2/authorization

# Notification service SMTP (optional for local)
# For Gmail, use an App Password (16 chars), not your account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Local dev defaults to keep notification-service healthy without SMTP creds
MANAGEMENT_HEALTH_MAIL_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false

# MailHog local profile (no real SMTP credentials needed)
# Enable with: COMPOSE_PROFILES=mailhog and NOTIFICATION_SPRING_PROFILES_ACTIVE=docker,mailhog
NOTIFICATION_SPRING_PROFILES_ACTIVE=docker


# Job market: which jobs candidates see and are matched against. IN = India (India imports plus jobs posted
# in the app); blank = every job. HR always sees every job. Compose defaults to IN.
# JOB_MARKET=IN
# The US/global job import. Compose pauses it (false) while the app serves India; the India import keeps running.
# JOB_SYNC_GLOBAL_ENABLED=false
