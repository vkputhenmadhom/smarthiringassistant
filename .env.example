# Environment Variables for Smart Hiring Assistant
# Copy this file to .env and update with your actual values

# JWT Configuration
# Shared by auth-service and api-gateway; at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/smart_hiring_db
DB_USERNAME=hiring_user
DB_PASSWORD=hiring_password

# Docker Compose infrastructure credentials (required by docker-compose*.yml).
# They are applied when a volume is first created; changing them later needs `docker compose down -v`.
POSTGRES_USER=hiring_user
POSTGRES_PASSWORD=change-me-postgres
MONGO_USERNAME=hiring_user
MONGO_PASSWORD=change-me-mongo
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hiring_user
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# OpenAI API (optional)
OPENAI_API_KEY=

# Logging Level
LOGGING_LEVEL=INFO

# OAuth Configuration (Auth Service)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth callbacks must go directly to auth-service (not gateway) so the JSESSIONID
# that holds the state/portal hint is present on the callback request.
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/login/oauth2/code/google
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login
OAUTH2_SUCCESS_REDIRECT_URI_CANDIDATE=http://localhost:5173/auth/callback
OAUTH2_SUCCESS_REDIRECT_URI_HR_ADMIN=http://localhost:4200/auth/callback

# Google-verified emails that become approved HR admins on first Google sign-in.
# Other HR sign-ups stay pending until one of these admins approves them.
BOOTSTRAP_ADMIN_EMAILS=

# Candidate portal: override OAuth base if needed (defaults to localhost:8001 direct)
# VITE_OAUTH_BASE_URL=http://localhost:8001/api/auth/oauth2/authorization

# Notification service SMTP (optional for local)
# For Gmail, use an App Password (16 chars), not your account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Local dev defaults to keep notification-service healthy without SMTP creds
MANAGEMENT_HEALTH_MAIL_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false

# MailHog local profile (no real SMTP credentials needed)
# Enable with: COMPOSE_PROFILES=mailhog and NOTIFICATION_SPRING_PROFILES_ACTIVE=docker,mailhog
NOTIFICATION_SPRING_PROFILES_ACTIVE=docker

